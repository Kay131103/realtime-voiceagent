# No secrets belong here: the Gemini API key lives only in backend/.env.

# Where Next.js proxies /api/* (server-side, not exposed to the browser).
BACKEND_URL=http://127.0.0.1:8000

# Optional: shared secret forwarded to the backend as `Authorization: Bearer`.
# Injected server-side by /api/session-token; never exposed to the browser.
# BACKEND_AUTH_TOKEN=

# Optional: call a backend on another origin directly instead of the proxy.
# It must then be listed in the backend's ALLOWED_ORIGINS.
# NEXT_PUBLIC_BACKEND_URL=https://voice-api.example.com
