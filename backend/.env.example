# Required. Create one at https://aistudio.google.com/apikey - never commit the real value.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional overrides (defaults shown).
GEMINI_MODEL=gemini-3.8-live
GEMINI_VOICE=Kore
GEMINI_API_VERSION=v1alpha
# GEMINI_SYSTEM_INSTRUCTION=You are a friendly, concise voice assistant.

# Comma-separated browser origins allowed to call the backend directly.
ALLOWED_ORIGINS=http://localhost:3000
TOKEN_RATE_LIMIT_PER_MINUTE=10
TOKEN_TTL_MINUTES=30
HOST=127.0.0.1
PORT=8000
