# Required. Create one at https://aistudio.google.com/apikey - never commit the real value.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional overrides (defaults shown).
GEMINI_MODEL=gemini-3.8-live
GEMINI_VOICE=Kore
# Default language when the request doesn't specify one: "auto" mirrors the
# user's language (fully multilingual), or pin a BCP-47 code like en-IN, hi-IN,
# ta-IN, es-US to lock the voice to that language/accent.
GEMINI_LANGUAGE=auto
GEMINI_API_VERSION=v1alpha
# GEMINI_SYSTEM_INSTRUCTION=You are a friendly, concise voice assistant.

# Comma-separated browser origins allowed to call the backend directly.
ALLOWED_ORIGINS=http://localhost:3000
TOKEN_RATE_LIMIT_PER_MINUTE=10
TOKEN_TTL_MINUTES=30

# Optional: require this shared secret on POST /api/session-token
# (sent as `Authorization: Bearer <token>`). Leave empty to disable.
AUTH_TOKEN=

HOST=127.0.0.1
PORT=8000
